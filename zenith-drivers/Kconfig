# Zenith drivers configuration
#

menu "Zenith Drivers"

config FAST_CHARGE
	tristate "Fast Charge — universal charger current booster"
	depends on POWER_SUPPLY
	default m
	help
	  Loadable module that boosts charge current and input current limit
	  via the standard power supply class API. Uses only EXPORT_SYMBOL_GPL
	  symbols so it works on any GKI 5.10+ device regardless of the vendor
	  charger IC driver.

	  Scans charger-type power supplies (USB, USB_PD, MAINS, etc.) and bumps:
	    - Constant charge current (CC phase)
	    - Input current limit
	    - Constant charge voltage (CV phase, optional)

	  Safety features:
	    - Respects hardware maximums advertised by the charger IC
	    - Checks battery temperature before boosting (configurable threshold)
	    - Only boosts when supply is online and charging

	  Sysfs interface at /sys/kernel/fast_charge/:
	    enabled              — toggle on/off (RW)
	    charge_current_ua    — CC current target (RW, 0 = hw max)
	    input_current_ua     — Input current limit (RW, 0 = hw max)
	    status               — RO stats and current settings

	  Module parameters:
	    charge_current_ua=3000000       default 3A
	    input_current_ua=3000000        default 3A
	    batt_temp_max_decicelsius=450   skip boost if battery >45°C
	    boost_cv_voltage=1              also boost CV voltage

endmenu
